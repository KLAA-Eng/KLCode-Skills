{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KLCode project configuration",
  "description": "Tracked project defaults. config.local.json is a partial override. Checks are explicitly trusted native read-only commands, not sandboxed programs. No hooks activate until enabled is true and the host registration is separately installed.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version"],
  "properties": {
    "schema_version": { "const": 1 },
    "hooks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "session_guidance": { "type": "boolean", "default": true },
        "operations": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": { "enum": ["off", "warn", "block"], "default": "warn" }
          }
        },
        "quality": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean", "default": true },
            "checks": {
              "type": "array",
              "maxItems": 16,
              "default": [],
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "extensions", "argv"],
                "properties": {
                  "id": { "type": "string", "pattern": "^[a-z0-9-]{1,48}$" },
                  "extensions": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 32,
                    "items": {
                      "type": "string",
                      "pattern": "^\\.[a-zA-Z0-9]{1,16}$"
                    }
                  },
                  "argv": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 64,
                    "prefixItems": [
                      {
                        "type": "string",
                        "pattern": "^(\\{node\\}|(?:[A-Za-z]:[\\\\/]|\\\\\\\\).+\\.[eE][xX][eE])$"
                      }
                    ],
                    "items": { "type": "string", "maxLength": 4096 }
                  },
                  "timeout_ms": {
                    "type": "integer",
                    "minimum": 50,
                    "maximum": 10000,
                    "default": 3000
                  }
                }
              }
            }
          }
        },
        "completion": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": { "enum": ["off", "warn", "block"], "default": "warn" },
            "max_block_attempts": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3,
              "default": 1
            }
          }
        }
      }
    }
  }
}
